  function startFormal() {
    P.isPractice = false;
    P.trials = [];
    P.CONDITIONS.forEach(cond => {
      for (let i = 0; i < P.FORMAL_TRIALS_PER_COND; i++) {
        P.trials.push(createTrial(cond, 'formal', i));
