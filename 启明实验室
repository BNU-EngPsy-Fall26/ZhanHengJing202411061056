/* ============================================================================
 * 比例判断实验（项目 2XHQAJ）
 * ============================================================================ */
(function () {
  const P = {
    CONDITIONS: ['bar', 'pie', 'circle', 'pie_tick'],
    FORMAL_TRIALS_PER_COND: 10,
    PRACTICE_TRIALS: 2,
    participantId: '',
    trials: [],
    currentTrialIndex: 0,
    isPractice: false,
    csvData: [],
    displayTimeout: null,
    trialStartTime: 0
  };

  const COND_COLORS = { bar: '#4A90D9', pie: '#E74C3C', circle: '#27AE60', pie_tick: '#8E44AD' };

  /* ---- 统计工具 ---- */
  const mean = arr => arr.length ? arr.reduce((s, v) => s + v, 0) / arr.length : 0;
  const sd = arr => {
    if (arr.length < 2) return 0;
    const m = mean(arr);
    return Math.sqrt(arr.reduce((s, v) => s + (v - m) ** 2, 0) / (arr.length - 1));
  };
  const median = arr => {
    if (!arr.length) return 0;
    const s = [...arr].sort((a, b) => a - b);
    const mid = Math.floor(s.length / 2);
    return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
  };
  const quantile = (arr, q) => {
    const s = [...arr].sort((a, b) => a - b);
    const pos = (s.length - 1) * q;
    const base = Math.floor(pos);
    const rest = pos - base;
    return s[base + 1] !== undefined ? s[base] + rest * (s[base + 1] - s[base]) : s[base];
  };
  const se = arr => arr.length > 1 ? sd(arr) / Math.sqrt(arr.length) : 0;

  function linearFit(xs, ys) {
    const n = xs.length;
    if (n < 2) return { k: 0, b: 0, r2: 0 };
    const mx = mean(xs), my = mean(ys);
    let sxy = 0, sxx = 0, syy = 0;
    for (let i = 0; i < n; i++) {
      sxy += (xs[i] - mx) * (ys[i] - my);
      sxx += (xs[i] - mx) ** 2;
      syy += (ys[i] - my) ** 2;
    }
    const k = sxx === 0 ? 0 : sxy / sxx;
    return { k, b: my - k * mx, r2: (sxx === 0 || syy === 0) ? 0 : (sxy * sxy) / (sxx * syy) };
  }

  function tCDF(t, df) {
    const x = df / (df + t * t);
    const ib = incompleteBeta(x, df / 2, 0.5);
    return t > 0 ? 1 - 0.5 * ib : 0.5 * ib;
  }
  function fCDF(F, df1, df2) {
    return incompleteBeta(df1 * F / (df1 * F + df2), df1 / 2, df2 / 2);
  }
  function incompleteBeta(x, a, b) {
    if (x <= 0) return 0;
    if (x >= 1) return 1;
    const n = 300, dt = x / n;
    let sum = 0;
    for (let i = 0; i < n; i++) {
      const t = (i + 0.5) * dt;
      sum += Math.pow(t, a - 1) * Math.pow(1 - t, b - 1) * dt;
    }
    const norm = Math.exp(lgamma(a) + lgamma(b) - lgamma(a + b));
    return Math.min(1, sum / norm * Math.pow(x, a) * Math.pow(1 - x, b));
  }
  function lgamma(z) {
    const g = 7;
    const c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
      771.32342877765313, -176.61502916214059, 12.507343278686905,
      -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
    if (z < 0.5) return Math.log(Math.PI / Math.sin(Math.PI * z)) - lgamma(1 - z);
    z -= 1;
    let x = c[0];
    for (let i = 1; i < g + 2; i++) x += c[i] / (z + i);
    const t = z + g + 0.5;
    return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
  }

  function tTestWelch(a, b) {
    const na = a.length, nb = b.length;
    if (na < 2 || nb < 2) return { t: 0, p: 1 };
    const ma = mean(a), mb = mean(b);
    const va = sd(a) ** 2, vb = sd(b) ** 2;
    const t = (ma - mb) / Math.sqrt(va / na + vb / nb);
    const df = (va / na + vb / nb) ** 2 /
      ((va / na) ** 2 / (na - 1) + (vb / nb) ** 2 / (nb - 1));
    return { t, p: 2 * (1 - tCDF(Math.abs(t), df)) };
  }

  function oneWayANOVA(groups) {
    const all = groups.flat();
    const grand = mean(all);
    const k = groups.length, N = all.length;
    if (k < 2 || N <= k) return { F: 0, dfB: k - 1, dfW: Math.max(1, N - k), p: 1, eta2: 0 };
    const ssB = groups.reduce((s, g) => s + g.length * (mean(g) - grand) ** 2, 0);
    const ssW = groups.reduce((s, g) => s + g.reduce((ss, v) => ss + (v - mean(g)) ** 2, 0), 0);
    const dfB = k - 1, dfW = N - k;
    const F = (ssW === 0) ? 0 : (ssB / dfB) / (ssW / dfW);
    return { F, dfB, dfW, p: 1 - fCDF(F, dfB, dfW), eta2: (ssB + ssW) === 0 ? 0 : ssB / (ssB + ssW) };
  }

