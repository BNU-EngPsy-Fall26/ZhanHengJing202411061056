  };

  window.vStartPractice = function () {
    V.isPractice = true;
    showVPage('v-experiment');

    V.allTrials = [];
    const cond = V.CONDITIONS[V.currentConditionIndex];

    for (let i = 0; i < V.PRACTICE_TRIALS; i++) {
      V.allTrials.push(createSingleTrial(cond, V.SET_SIZES[Math.floor(Math.random() * 4)], Math.random() < 0.5, true));
    }

    V.currentTrial = 0;
    runTrial();
  };

  function startFormal() {
    V.isPractice = false;
    showVPage('v-experiment');

    V.allTrials = [];
    const cond = V.CONDITIONS[V.currentConditionIndex];

    V.SET_SIZES.forEach(size => {
      [true, false].forEach(present => {
        for (let i = 0; i < V.FORMAL_REPEATS; i++) {
          V.allTrials.push(createSingleTrial(cond, size, present, false));
        }
      });
    });

    V.allTrials.sort(() => Math.random() - 0.5);
    V.currentTrial = 0;
    runTrial();
  }

  function createSingleTrial(cond, size, present, practice) {
    let items = [];
    if (present) {
      items.push({ type: 'circle', color: 'red' });
      for (let i = 1; i < size; i++) items.push(pickRandom(cond.distractors));
    } else {
      for (let i = 0; i < size; i++) items.push(pickRandom(cond.distractors));
    }

    return {
      condition: cond.name,
      setSize: size,
      targetPresent: present,
      items,
      response: null,
      rt: null,
      correct: null,
      isPractice: practice,
      _timeout: null
    };
  }

  function pickRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function renderStimulus(items) {
    const area = document.getElementById('v-stimulusArea');
    const feedback = document.getElementById('v-feedback');
    const fixation = document.getElementById('v-fixation');

    Array.from(area.children).forEach(child => {
      if (child.id !== 'v-feedback' && child.id !== 'v-fixation') child.remove();
    });

    feedback.style.display = 'none';
    fixation.style.display = 'none';

    if (!items || items.length === 0) {
      fixation.style.display = 'block';
      return;
    }

    const areaW = area.clientWidth;
    const areaH = area.clientHeight;
    const cols = 6, rows = 4;
    const marginX = Math.min(80, areaW * 0.1);
    const marginY = Math.min(60, areaH * 0.12);
    const gridW = areaW - marginX * 2;
    const gridH = areaH - marginY * 2;

    let slots = [];
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        slots.push({
          x: marginX + (gridW / (cols - 1)) * c,
          y: marginY + (gridH / (rows - 1)) * r
        });
      }
    }
    slots.sort(() => Math.random() - 0.5);

    items.forEach((item, i) => {
      const el = document.createElement('div');
      el.className = `v-shape v-${item.type} v-${item.color}`;
      if (item.type === 'cross') el.textContent = '✕';
      el.style.left = (slots[i].x - 18) + 'px';
      el.style.top = (slots[i].y - 18) + 'px';
      area.appendChild(el);
    });
  }

  function runTrial() {
    if (V.currentTrial >= V.allTrials.length) {
      finishBlock();
      return;
    }

    V.responded = false;
    V.isAcceptingResponse = false;

    renderStimulus(null);

    setTimeout(() => {
      if (V.currentTrial >= V.allTrials.length) return;
      const trial = V.allTrials[V.currentTrial];
      renderStimulus(trial.items);

      const totalStr = V.isPractice ? V.PRACTICE_TRIALS : V.allTrials.length;
      const phaseStr = V.isPractice ? '【练习】' : '【正式】';
      document.getElementById('v-progress').textContent =
        `${phaseStr} ${V.CONDITIONS[V.currentConditionIndex].title} | 进度: ${V.currentTrial + 1} / ${totalStr}`;

      V.trialStartTime = performance.now();
      V.isAcceptingResponse = true;

      if (trial._timeout) clearTimeout(trial._timeout);
      trial._timeout = setTimeout(() => {
        if (!V.responded) {
          V.responded = true;
          V.isAcceptingResponse = false;
          handleResponse('timeout');
        }
      }, V.STIMULUS_DURATION);
    }, V.ITI_DURATION);
  }

  function handleResponse(key) {
    const trial = V.allTrials[V.currentTrial];
    if (!trial) return;
    if (trial._timeout) { clearTimeout(trial._timeout); trial._timeout = null; }

    const rt = Math.round(performance.now() - V.trialStartTime);
    trial.response = key === 'f' ? 'present' : key === 'j' ? 'absent' : 'timeout';
    trial.rt = key === 'timeout' ? V.STIMULUS_DURATION : rt;

    if (key === 'timeout') {
      trial.correct = false;
    } else {
      trial.correct = (key === 'f') ? trial.targetPresent : !trial.targetPresent;
    }

    saveTrial(trial);

    if (V.isPractice) {
      const feedback = document.getElementById('v-feedback');
      feedback.style.display = 'block';
      if (key === 'timeout') {
        feedback.textContent = '超时';
        feedback.className = 'fb-timeout';
      } else if (trial.correct) {
        feedback.textContent = '正确';
        feedback.className = 'fb-correct';
      } else {
        feedback.textContent = '错误';
        feedback.className = 'fb-wrong';
      }
      setTimeout(() => {
        V.currentTrial++;
        runTrial();
      }, 800);
    } else {
      V.currentTrial++;
      runTrial();
    }
  }

  document.addEventListener('keydown', (e) => {
    if (!document.getElementById('exp-visual').classList.contains('active')) return;
    if (!V.isAcceptingResponse || V.responded) return;
    const key = e.key.toLowerCase();
    if (key !== 'f' && key !== 'j') return;
    V.responded = true;
    V.isAcceptingResponse = false;
    handleResponse(key);
  });

  function saveTrial(trial) {
    const dataRow = {
      participantId: V.participantId,
      block: V.currentConditionIndex + 1,
      condition: trial.condition,
      phase: V.isPractice ? 'practice' : 'formal',
      setSize: trial.setSize,
      targetPresent: trial.targetPresent,
      response: trial.response,
      correct: trial.correct,
      rt: trial.rt,
      timestamp: new Date().toISOString()
    };

    if (!V.isPractice) V.csvData.push(dataRow);

    /* 每个 trial（含练习）立即上传 */
    uploadTrial({
      project: PROJECT_CODE_VISUAL,
      experiment: 'visual_search_improved',
      participant: V.participantId,
      condition: trial.condition,
      trials: [dataRow]
    });
  }

  function finishBlock() {
    V.isAcceptingResponse = false;

    if (V.isPractice) {
      showVPage('v-instructionBlock');
      document.getElementById('v-instTitle').textContent = V.CONDITIONS[V.currentConditionIndex].title + ' - 正式实验';
      document.getElementById('v-instText').textContent = '练习结束。接下来是正式实验，没有正误反馈。请尽量又快又准地反应。';
      document.getElementById('v-distractorDemo1').style.display = 'none';
      document.getElementById('v-instPracticeText').style.display = 'none';

      const btn = document.getElementById('v-instBtn');
      btn.textContent = '开始正式实验';
      btn.className = '';
      btn.onclick = startFormal;
    } else {
      if (V.currentConditionIndex < V.CONDITIONS.length - 1) {
        window.vShowInstruction(V.currentConditionIndex + 1);
      } else {
        showVPage('v-finished');
        generateResults();
      }
    }
  }

  function generateResults() {
    const validData = V.csvData.filter(d => d.phase === 'formal' && d.correct === true && d.response === 'present');

    if (validData.length === 0) {
      document.getElementById('v-chartError').style.display = 'block';
      return;
    }
    document.getElementById('v-chartError').style.display = 'none';

    let maxRT = 1000;
    let totalRTs = {};
    let series = [];
    let tableHtml = '';

    V.CONDITIONS.forEach(c => {
      let points = [];
      let condTotalRT = 0;
      let condCount = 0;

      V.SET_SIZES.forEach(size => {
        let filtered = validData.filter(d => d.condition === c.name && d.setSize === size);
        let meanRT = filtered.length ? filtered.reduce((sum, d) => sum + d.rt, 0) / filtered.length : null;

        if (meanRT !== null) {
          if (meanRT > maxRT) maxRT = meanRT;
          condTotalRT += meanRT;
          condCount++;
        }
        points.push({ size, rt: meanRT });
      });

      let overallMean = condCount > 0 ? Math.round(condTotalRT / condCount) : 0;
      totalRTs[c.name] = overallMean;

      if (points.some(p => p.rt !== null)) {
        series.push({ ...c, points });
      }

      tableHtml += `<tr>
        <td style="color:${c.color}; font-weight:bold;">${c.title}</td>
        <td>${points[0].rt ? Math.round(points[0].rt) : '-'}</td>
        <td>${points[1].rt ? Math.round(points[1].rt) : '-'}</td>
        <td>${points[2].rt ? Math.round(points[2].rt) : '-'}</td>
        <td>${points[3].rt ? Math.round(points[3].rt) : '-'}</td>
        <td style="font-weight:bold;">${overallMean > 0 ? overallMean : '-'}</td>
      </tr>`;
    });

    document.querySelector('#v-dataTable tbody').innerHTML = tableHtml;

    if (series.length === 0) {
      document.getElementById('v-chartError').style.display = 'block';
      return;
    }

    maxRT = Math.ceil(maxRT / 500) * 500;

    /* 折线图 */
    const canvasLine = document.getElementById('v-resultChart');
    const ctxLine = canvasLine.getContext('2d');
    const wL = canvasLine.width, hL = canvasLine.height;
    const padL = 60, padB = 40, padT = 20, padR = 20;
    const cw = wL - padL - padR, ch = hL - padT - padB;

    ctxLine.clearRect(0, 0, wL, hL);
    ctxLine.beginPath(); ctxLine.strokeStyle = '#999'; ctxLine.lineWidth = 1;
    ctxLine.moveTo(padL, padT); ctxLine.lineTo(padL, hL - padB); ctxLine.lineTo(wL - padR, hL - padB); ctxLine.stroke();

    ctxLine.fillStyle = '#666'; ctxLine.font = '12px sans-serif';
    ctxLine.textAlign = 'right'; ctxLine.textBaseline = 'middle';
    for (let i = 0; i <= 4; i++) {
      let val = (maxRT / 4) * i;
      let y = hL - padB - (val / maxRT) * ch;
      ctxLine.fillText(val + 'ms', padL - 10, y);
      ctxLine.beginPath(); ctxLine.moveTo(padL - 5, y); ctxLine.lineTo(padL, y); ctxLine.stroke();
    }

    ctxLine.textAlign = 'center'; ctxLine.textBaseline = 'top';
    V.SET_SIZES.forEach((size, i) => {
      let x = padL + (i / (V.SET_SIZES.length - 1)) * cw;
      ctxLine.fillText(size, x, hL - padB + 10);
    });

    series.forEach(s => {
      ctxLine.beginPath(); ctxLine.strokeStyle = s.color; ctxLine.lineWidth = 3;
      let hasStarted = false;

      s.points.forEach((p, i) => {
        if (p.rt === null) return;
        let x = padL + (i / (V.SET_SIZES.length - 1)) * cw;
        let y = hL - padB - (p.rt / maxRT) * ch;
        if (!hasStarted) {
          ctxLine.moveTo(x, y);
          hasStarted = true;
        } else {
          ctxLine.lineTo(x, y);
        }
      });
      ctxLine.stroke();

      ctxLine.fillStyle = s.color;
      s.points.forEach((p, i) => {
        if (p.rt === null) return;
        let x = padL + (i / (V.SET_SIZES.length - 1)) * cw;
        let y = hL - padB - (p.rt / maxRT) * ch;
        ctxLine.beginPath(); ctxLine.arc(x, y, 5, 0, Math.PI * 2); ctxLine.fill();
      });
    });

    /* 柱状图 */
    const canvasBar = document.getElementById('v-barChart');
    const ctxBar = canvasBar.getContext('2d');
    const wB = canvasBar.width, hB = canvasBar.height;
    const padB2 = 40, padT2 = 20, padL2 = 60, padR2 = 20;
    const chB = hB - padT2 - padB2;
    const cwB = wB - padL2 - padR2;

    let maxBarRT = 1000;
    for (let k in totalRTs) { if (totalRTs[k] > maxBarRT) maxBarRT = totalRTs[k]; }
    maxBarRT = Math.ceil(maxBarRT / 500) * 500;

    ctxBar.clearRect(0, 0, wB, hB);
    ctxBar.beginPath(); ctxBar.strokeStyle = '#999'; ctxBar.lineWidth = 1;
    ctxBar.moveTo(padL2, padT2); ctxBar.lineTo(padL2, hB - padB2); ctxBar.lineTo(wB - padR2, hB - padB2); ctxBar.stroke();

    ctxBar.fillStyle = '#666'; ctxBar.font = '12px sans-serif';
    ctxBar.textAlign = 'right'; ctxBar.textBaseline = 'middle';
    for (let i = 0; i <= 4; i++) {
      let val = (maxBarRT / 4) * i;
      let y = hB - padB2 - (val / maxBarRT) * chB;
      ctxBar.fillText(val + 'ms', padL2 - 10, y);
      ctxBar.beginPath(); ctxBar.moveTo(padL2 - 5, y); ctxBar.lineTo(padL2, y); ctxBar.stroke();
    }

    const barWidth = 100;
    const spacing = cwB / V.CONDITIONS.length;

    V.CONDITIONS.forEach((c, i) => {
      let rt = totalRTs[c.name];
      if (!rt) return;

      let x = padL2 + i * spacing + (spacing - barWidth) / 2;
      let barHeight = (rt / maxBarRT) * chB;
      let y = hB - padB2 - barHeight;

      ctxBar.fillStyle = c.color;
      ctxBar.fillRect(x, y, barWidth, barHeight);

      ctxBar.fillStyle = '#333';
      ctxBar.textAlign = 'center'; ctxBar.textBaseline = 'bottom';
      ctxBar.fillText(rt + ' ms', x + barWidth / 2, y - 5);

      ctxBar.textAlign = 'center'; ctxBar.textBaseline = 'top';
      ctxBar.fillText(c.title.split(' ')[0], x + barWidth / 2, hB - padB2 + 10);
    });
  }
})();
</script>
