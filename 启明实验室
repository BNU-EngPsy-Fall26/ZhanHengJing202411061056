      document.getElementById('p-instTitle').textContent = '正式实验说明';
      document.getElementById('p-instText').innerHTML = '练习结束。接下来是 <b>40 个正式试次</b>，四种图形将随机混合出现，且没有正误反馈。<br>请<b>凭借你的第一直觉作答即可</b>。';
      const btn = document.getElementById('p-instBtn');
      btn.textContent = '开始正式实验';
