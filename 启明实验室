  function generateArrayHTML(itemsHTML) {
    return `<div style="display:flex; align-items:center; justify-content:center; gap:30px; height:400px;">
      ${itemsHTML.join('')}
    </div>`;
  }

  function drawStimulus(trial) {
    const display = document.getElementById('p-displayArea');
    display.innerHTML = '';
    const condition = trial.condition;

    if (condition === 'bar') {
      const maxH = 280;
      const hA = maxH;
      const hB = maxH * (trial.actualPercentage / 100);
      const randomHeights = [40 + Math.random() * 200, 40 + Math.random() * 200, 40 + Math.random() * 200];

      let items = [];
      items.push(`<div style="width:40px; height:${randomHeights[0]}px; background:#e2e8f0; border:2px solid #1e3a8a;"></div>`);
      items.push(`<div style="display:flex; flex-direction:column; align-items:center;">
            <span style="color:#E74C3C; font-weight:bold; font-size:20px; margin-bottom:5px;">A</span>
            <div style="width:40px; height:${hA}px; background:#e2e8f0; border:2px solid #1e3a8a;"></div>
          </div>`);
      items.push(`<div style="width:40px; height:${randomHeights[1]}px; background:#e2e8f0; border:2px solid #1e3a8a;"></div>`);
      items.push(`<div style="display:flex; flex-direction:column; align-items:center;">
            <span style="color:#E74C3C; font-weight:bold; font-size:20px; margin-bottom:5px;">B</span>
            <div style="width:40px; height:${hB}px; background:#e2e8f0; border:2px solid #1e3a8a;"></div>
          </div>`);
      items.push(`<div style="width:40px; height:${randomHeights[2]}px; background:#e2e8f0; border:2px solid #1e3a8a;"></div>`);

      display.innerHTML = generateArrayHTML(items);
    } else if (condition === 'pie' || condition === 'pie_tick') {
      const r = 150;
      const cx = 200, cy = 200;
      const a = trial.a, b = trial.b, x = trial.x, y = trial.y;
      const startA = 0;
      const startB = startA + a;
      const startX = startB + b;
      const startY = startX + x;

      function drawSlice(startAngle, angleSize) {
        const safeAngle = Math.min(angleSize, 359.999);
        function point(angle) {
          const rad = (angle - 90) * Math.PI / 180;
          return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
        }
        const start = point(startAngle);
        const middle = point(startAngle + safeAngle / 2);
        const end = point(startAngle + safeAngle);
        return `
          <path d="
              M ${cx} ${cy}
              L ${start.x} ${start.y}
              A ${r} ${r} 0 0 1 ${middle.x} ${middle.y}
              A ${r} ${r} 0 0 1 ${end.x} ${end.y}
              Z
            " class="shape-fill" />
        `;
      }

      let svgHtml = `<svg width="400" height="400">`;
      svgHtml += drawSlice(startA, a);
      svgHtml += drawSlice(startB, b);
      svgHtml += drawSlice(startX, x);
      svgHtml += drawSlice(startY, y);

      const posA = polarToXY(cx, cy, r * 0.6, startA + a / 2);
      const posB = polarToXY(cx, cy, r * 0.6, startB + b / 2);

      svgHtml += `
        <text x="${posA.x}" y="${posA.y}" class="label-text" text-anchor="middle" dominant-baseline="middle">A</text>
        <text x="${posB.x}" y="${posB.y}" class="label-text" text-anchor="middle" dominant-baseline="middle">B</text>
      `;

      if (condition === 'pie_tick') {
        const ticks = [0.25, 0.5, 0.75];
        ticks.forEach(t => {
          const angle = t * 360;
          const rad = (angle - 90) * Math.PI / 180;
          const tx = cx + r * Math.cos(rad);
          const ty = cy + r * Math.sin(rad);
          svgHtml += `<line x1="${cx}" y1="${cy}" x2="${tx}" y2="${ty}" class="tick-mark" />`;
          const textX = cx + (r + 25) * Math.cos(rad);
          const textY = cy + (r + 25) * Math.sin(rad);
          svgHtml += `<text x="${textX}" y="${textY}" class="tick-text" text-anchor="middle" dominant-baseline="middle">${t}</text>`;
        });
      }
      svgHtml += `</svg>`;
      display.innerHTML = svgHtml;
    } else if (condition === 'circle') {
      const maxR = 120;
      const rA = maxR;
      const rB = maxR * Math.sqrt(trial.actualPercentage / 100);
      const randomRadii = [30 + Math.random() * 80, 30 + Math.random() * 80, 30 + Math.random() * 80];

      let items = [];
      items.push(`<div style="width:${randomRadii[0]*2}px; height:${randomRadii[0]*2}px; border-radius:50%; background:#e2e8f0; border:2px solid #1e3a8a;"></div>`);
      items.push(`<div style="display:flex; flex-direction:column; align-items:center;">
            <span style="color:#E74C3C; font-weight:bold; font-size:20px; margin-bottom:10px;">A</span>
            <div style="width:${rA*2}px; height:${rA*2}px; border-radius:50%; background:#e2e8f0; border:2px solid #1e3a8a;"></div>
          </div>`);
      items.push(`<div style="width:${randomRadii[1]*2}px; height:${randomRadii[1]*2}px; border-radius:50%; background:#e2e8f0; border:2px solid #1e3a8a;"></div>`);
      items.push(`<div style="display:flex; flex-direction:column; align-items:center;">
            <span style="color:#E74C3C; font-weight:bold; font-size:20px; margin-bottom:10px;">B</span>
            <div style="width:${rB*2}px; height:${rB*2}px; border-radius:50%; background:#e2e8f0; border:2px solid #1e3a8a;"></div>
          </div>`);
      items.push(`<div style="width:${randomRadii[2]*2}px; height:${randomRadii[2]*2}px; border-radius:50%; background:#e2e8f0; border:2px solid #1e3a8a;"></div>`);

      display.innerHTML = generateArrayHTML(items);
    }
  }

  function polarToXY(cx, cy, radius, angleDeg) {
    const rad = (angleDeg - 90) * Math.PI / 180;
    return { x: cx + radius * Math.cos(rad), y: cy + radius * Math.sin(rad) };
  }

  window.pSubmitAnswer = function () {
    document.getElementById('p-submitBtn').disabled = true;
    const userPct = parseFloat(input.value) || 0;
    const trial = P.trials[P.currentTrialIndex];
    if (!trial) return;

    const dataRow = {
      participantId: P.participantId,
      experiment: 'proportion_judgment',
      condition: trial.condition,
      phase: trial.phase,
      trialIndex: P.currentTrialIndex,
      actualPct: trial.actualPercentage.toFixed(2),
      userPct: userPct.toFixed(2),
      rt: P.trialStartTime ? (Date.now() - P.trialStartTime) : 0,
      timestamp: new Date().toISOString()
    };
    P.csvData.push(dataRow);

    /* 立即上传当前 trial */
    uploadTrial({
      project: PROJECT_CODE_PROPORTION,
      experiment: 'proportion_judgment',
      participant: P.participantId,
      condition: trial.condition,
      phase: trial.phase,
      trials: [dataRow]
    });

    if (P.isPractice) {
      const overlay = document.getElementById('p-feedbackOverlay');
      document.getElementById('p-fbActual').textContent = trial.actualPercentage.toFixed(1) + '%';
      document.getElementById('p-fbUser').textContent = userPct.toFixed(1) + '%';
      overlay.classList.add('p-show');
    } else {
      P.currentTrialIndex++;
      runTrial();
    }
  };

  window.pNextTrial = function () {
    document.getElementById('p-feedbackOverlay').classList.remove('p-show');
