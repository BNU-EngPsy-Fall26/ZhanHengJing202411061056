  function finishExperiment() {
    showPPage('p-finished');
    document.getElementById('p-topBar').classList.remove('p-show');
    document.getElementById('p-controlPanel').classList.remove('p-show');
    renderFullAnalysis();
  }

  function renderFullAnalysis() {
    const formal = P.csvData.filter(d => d.phase === 'formal');
    if (!formal.length) {
      document.getElementById('p-analysisWrap').innerHTML = '<p style="text-align:center;color:#888;padding:40px 0;">暂无正式实验数据。</p>';
      return;
    }

    const conds = P.CONDITIONS;
    const groups = {};
    conds.forEach(c => groups[c] = { abs: [], err: [], actual: [], user: [], rt: [] });
    formal.forEach(d => {
      const a = parseFloat(d.actualPct);
      const u = parseFloat(d.userPct);
      const g = groups[d.condition];
      if (!g) return;
      g.actual.push(a);
      g.user.push(u);
      g.abs.push(Math.abs(u - a));
      g.err.push(u - a);
      g.rt.push(parseFloat(d.rt) || 0);
    });

    document.getElementById('p-analysisWrap').innerHTML = `
      <h2>实验数据分析</h2>
      <p class="p-analysis-sub">正式试次 ${formal.length} | 条件 ${conds.length}</p>
      <div id="p-barArea" style="text-align:center; margin-bottom:26px;"></div>
      <div class="p-grid2">
        <div id="p-calibArea" style="text-align:center;"></div>
        <div id="p-boxArea" style="text-align:center;"></div>
      </div>
      <div id="p-rtArea" style="text-align:center; margin-bottom:26px;"></div>
      <div id="p-statArea"></div>
      <div style="text-align:center; margin:30px 0;">
        <button onclick="returnToHub()" style="background:#4A90D9;">退出</button>
      </div>
    `;

    drawBarChart(groups, conds);
    drawCalibration(groups, conds);
    drawBoxPlot(groups, conds);
    drawRTChart(groups, conds);
    drawStats(groups, conds);
  }

  function drawBarChart(groups, conds) {
    const W = 640, H = 360, padL = 60, padR = 20, padT = 30, padB = 55;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const stats = conds.map(c => ({ c, m: mean(groups[c].abs), se: se(groups[c].abs) }));
    const maxY = Math.max(...stats.map(s => s.m + s.se)) * 1.25 || 1;
    const gap = plotW / conds.length;
    const barW = gap * 0.5;

    let svg = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;max-width:${W}px;font-family:sans-serif;">`;
    for (let i = 0; i <= 4; i++) {
      const y = padT + plotH - (i / 4) * plotH;
      svg += `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="#eee"/>`;
      svg += `<text x="${padL - 8}" y="${y + 4}" text-anchor="end" font-size="11" fill="#666">${((i / 4) * maxY).toFixed(1)}</text>`;
    }
    stats.forEach((s, i) => {
      const x = padL + gap * i + (gap - barW) / 2;
      const bh = (s.m / maxY) * plotH;
      const y = padT + plotH - bh;
      const seH = (s.se / maxY) * plotH;
      const cx = x + barW / 2;
      svg += `<rect x="${x}" y="${y}" width="${barW}" height="${bh}" fill="${COND_COLORS[s.c]}" opacity="0.85" rx="4"/>`;
      svg += `<line x1="${cx}" y1="${y - seH}" x2="${cx}" y2="${y + seH}" stroke="#333" stroke-width="2"/>`;
      svg += `<line x1="${cx - 7}" y1="${y - seH}" x2="${cx + 7}" y2="${y - seH}" stroke="#333" stroke-width="2"/>`;
      svg += `<line x1="${cx - 7}" y1="${y + seH}" x2="${cx + 7}" y2="${y + seH}" stroke="#333" stroke-width="2"/>`;
      svg += `<text x="${cx}" y="${y - seH - 6}" text-anchor="middle" font-size="12" font-weight="bold" fill="#333">${s.m.toFixed(1)}</text>`;
      svg += `<text x="${cx}" y="${H - padB + 20}" text-anchor="middle" font-size="12" font-weight="bold" fill="#333">${s.c}</text>`;
    });
    svg += `<text x="16" y="${padT + plotH / 2}" text-anchor="middle" font-size="12" fill="#666" transform="rotate(-90 16 ${padT + plotH / 2})">绝对误差均值</text>`;
    svg += `</svg>`;

    document.getElementById('p-barArea').innerHTML = `
      <div class="p-chart-title">① 各条件 |误差| 均值（±SE）</div>
      ${svg}
    `;
  }

  function drawCalibration(groups, conds) {
    const W = 380, H = 360, padL = 45, padR = 15, padT = 20, padB = 45;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const sx = v => padL + (v / 100) * plotW;
    const sy = v => padT + plotH - (v / 100) * plotH;

    let svg = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;max-width:${W}px;font-family:sans-serif;">`;
    for (let i = 0; i <= 4; i++) {
      const gx = padL + (i / 4) * plotW;
      const gy = padT + (i / 4) * plotH;
      svg += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT + plotH}" stroke="#eee"/>`;
      svg += `<line x1="${padL}" y1="${gy}" x2="${padL + plotW}" y2="${gy}" stroke="#eee"/>`;
      svg += `<text x="${gx}" y="${padT + plotH + 16}" text-anchor="middle" font-size="10" fill="#666">${i * 25}</text>`;
      svg += `<text x="${padL - 6}" y="${gy + 3}" text-anchor="end" font-size="10" fill="#666">${100 - i * 25}</text>`;
    }
    svg += `<line x1="${sx(0)}" y1="${sy(0)}" x2="${sx(100)}" y2="${sy(100)}" stroke="#aaa" stroke-width="1.5" stroke-dasharray="5,4"/>`;

    let fitText = '';
    conds.forEach(c => {
      const g = groups[c];
      const color = COND_COLORS[c];
      g.actual.forEach((a, i) => {
        svg += `<circle cx="${sx(a)}" cy="${sy(g.user[i])}" r="3" fill="${color}" opacity="0.55"/>`;
      });
      if (g.actual.length >= 2) {
        const fit = linearFit(g.actual, g.user);
        const x1 = 10, x2 = 95;
        svg += `<line x1="${sx(x1)}" y1="${sy(fit.k * x1 + fit.b)}" x2="${sx(x2)}" y2="${sy(fit.k * x2 + fit.b)}"
                  stroke="${color}" stroke-width="2" opacity="0.9"/>`;
        fitText += `<span style="color:${color}; font-weight:bold; margin-right:10px;">${c}: k=${fit.k.toFixed(2)}</span>`;
      }
    });
    svg += `<text x="${padL + plotW / 2}" y="${H - 8}" text-anchor="middle" font-size="11" fill="#333">实际比例 (%)</text>`;
    svg += `<text x="12" y="${padT + plotH / 2}" text-anchor="middle" font-size="11" fill="#333" transform="rotate(-90 12 ${padT + plotH / 2})">被试估计 (%)</text>`;
    svg += `</svg>`;

    document.getElementById('p-calibArea').innerHTML = `
      <div class="p-chart-title">② 校准散点图</div>
      ${svg}
      <div style="font-size:11px; color:#666; margin-top:4px;">${fitText}</div>
      <div class="p-chart-note">虚线为 y=x 理想线；斜率 k&lt;1 表示向中间压缩</div>
    `;
  }

  function drawBoxPlot(groups, conds) {
    const W = 380, H = 360, padL = 45, padR = 15, padT = 20, padB = 45;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const allErr = conds.flatMap(c => groups[c].err);
    const yMax = Math.max(10, Math.ceil(Math.max(...allErr.map(Math.abs), 0) / 10) * 10);
    const sy = v => padT + plotH - ((v + yMax) / (2 * yMax)) * plotH;

    let svg = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;max-width:${W}px;font-family:sans-serif;">`;
    for (let i = -2; i <= 2; i++) {
      const v = (i / 2) * yMax;
      const y = sy(v);
      svg += `<line x1="${padL}" y1="${y}" x2="${padL + plotW}" y2="${y}" stroke="${i === 0 ? '#aaa' : '#eee'}" stroke-width="${i === 0 ? 1.5 : 1}"/>`;
      svg += `<text x="${padL - 6}" y="${y + 3}" text-anchor="end" font-size="10" fill="#666">${v.toFixed(0)}</text>`;
    }

    const gap = plotW / conds.length;
    const boxW = gap * 0.5;

    conds.forEach((c, i) => {
      const d = groups[c].err;
      if (d.length < 2) return;
      const s = [...d].sort((a, b) => a - b);
      const q1 = quantile(s, 0.25), q2 = quantile(s, 0.5), q3 = quantile(s, 0.75);
      const iqr = q3 - q1;
      const lowF = q1 - 1.5 * iqr, highF = q3 + 1.5 * iqr;
      const inliers = s.filter(v => v >= lowF && v <= highF);
      const outliers = s.filter(v => v < lowF || v > highF);
      const whiskLow = Math.min(...inliers), whiskHigh = Math.max(...inliers);
      const cx = padL + gap * i + gap / 2;
      const color = COND_COLORS[c];

      svg += `<line x1="${cx}" y1="${sy(whiskLow)}" x2="${cx}" y2="${sy(whiskHigh)}" stroke="#666" stroke-width="1.5"/>`;
      svg += `<line x1="${cx - 10}" y1="${sy(whiskLow)}" x2="${cx + 10}" y2="${sy(whiskLow)}" stroke="#666" stroke-width="1.5"/>`;
      svg += `<line x1="${cx - 10}" y1="${sy(whiskHigh)}" x2="${cx + 10}" y2="${sy(whiskHigh)}" stroke="#666" stroke-width="1.5"/>`;
      svg += `<rect x="${cx - boxW / 2}" y="${sy(q3)}" width="${boxW}" height="${sy(q1) - sy(q3)}"
                fill="${color}" opacity="0.6" stroke="${color}" stroke-width="1.5"/>`;
      svg += `<line x1="${cx - boxW / 2}" y1="${sy(q2)}" x2="${cx + boxW / 2}" y2="${sy(q2)}" stroke="#333" stroke-width="2"/>`;
      outliers.forEach(v => {
        svg += `<circle cx="${cx}" cy="${sy(v)}" r="2.5" fill="none" stroke="${color}" stroke-width="1.2"/>`;
      });
      svg += `<text x="${cx}" y="${H - padB + 20}" text-anchor="middle" font-size="11" font-weight="bold" fill="#333">${c}</text>`;
    });

    svg += `<text x="12" y="${padT + plotH / 2}" text-anchor="middle" font-size="11" fill="#333" transform="rotate(-90 12 ${padT + plotH / 2})">误差（估计−实际）</text>`;
    svg += `</svg>`;

    document.getElementById('p-boxArea').innerHTML = `
      <div class="p-chart-title">③ 各条件误差分布（箱线图）</div>
      ${svg}
      <div class="p-chart-note">中位线 + 四分位箱 + 1.5×IQR 须；空心圆为离群值</div>
    `;
  }

  function drawRTChart(groups, conds) {
    const hasRT = conds.some(c => groups[c].rt.some(v => v > 0));
    if (!hasRT) {
      document.getElementById('p-rtArea').innerHTML = `<div style="font-size:14px; color:#999; padding:16px;">④ 反应时分析：本次数据未记录 RT</div>`;
      return;
    }

    const W = 640, H = 340, padL = 70, padR = 20, padT = 30, padB = 55;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const stats = conds.map(c => {
      const valid = groups[c].rt.filter(v => v > 0);
      return { c, m: mean(valid), se: se(valid), n: valid.length };
    });
    const maxY = Math.max(...stats.map(s => s.m + s.se)) * 1.2 || 1;
    const gap = plotW / conds.length;
    const barW = gap * 0.5;

    let svg = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;max-width:${W}px;font-family:sans-serif;">`;
    for (let i = 0; i <= 4; i++) {
      const y = padT + plotH - (i / 4) * plotH;
      svg += `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="#eee"/>`;
      svg += `<text x="${padL - 8}" y="${y + 4}" text-anchor="end" font-size="11" fill="#666">${((i / 4) * maxY / 1000).toFixed(1)}s</text>`;
    }
    stats.forEach((s, i) => {
      const x = padL + gap * i + (gap - barW) / 2;
      const bh = (s.m / maxY) * plotH;
      const y = padT + plotH - bh;
      const seH = (s.se / maxY) * plotH;
      const cx = x + barW / 2;
      svg += `<rect x="${x}" y="${y}" width="${barW}" height="${bh}" fill="${COND_COLORS[s.c]}" opacity="0.75" rx="4"/>`;
      svg += `<line x1="${cx}" y1="${y - seH}" x2="${cx}" y2="${y + seH}" stroke="#333" stroke-width="2"/>`;
      svg += `<line x1="${cx - 7}" y1="${y - seH}" x2="${cx + 7}" y2="${y - seH}" stroke="#333" stroke-width="2"/>`;
      svg += `<line x1="${cx - 7}" y1="${y + seH}" x2="${cx + 7}" y2="${y + seH}" stroke="#333" stroke-width="2"/>`;
      svg += `<text x="${cx}" y="${y - seH - 6}" text-anchor="middle" font-size="12" font-weight="bold" fill="#333">${(s.m / 1000).toFixed(2)}s</text>`;
      svg += `<text x="${cx}" y="${H - padB + 20}" text-anchor="middle" font-size="12" font-weight="bold" fill="#333">${s.c}</text>`;
    });
    svg += `<text x="16" y="${padT + plotH / 2}" text-anchor="middle" font-size="12" fill="#666" transform="rotate(-90 16 ${padT + plotH / 2})">反应时 (s)</text>`;
    svg += `</svg>`;

    document.getElementById('p-rtArea').innerHTML = `
      <div class="p-chart-title">④ 各条件反应时（±SE）</div>
      ${svg}
    `;
  }

  function drawStats(groups, conds) {
    const anovaAbs = oneWayANOVA(conds.map(c => groups[c].abs));
    const anovaRT = oneWayANOVA(conds.map(c => groups[c].rt.filter(v => v > 0)));
    const fmtP = p => p < 0.001 ? '<0.001' : p.toFixed(3);
    const sig = p => p < 0.05 ? ' *' : '';

    let descRows = conds.map(c => {
      const abs = groups[c].abs, err = groups[c].err, rt = groups[c].rt.filter(v => v > 0);
      return `<tr>
        <td style="font-weight:bold;color:${COND_COLORS[c]};">${c}</td>
        <td>${abs.length}</td>
        <td>${mean(abs).toFixed(1)} ± ${sd(abs).toFixed(1)}</td>
        <td>${median(abs).toFixed(1)}</td>
        <td>${mean(err).toFixed(1)} ± ${sd(err).toFixed(1)}</td>
        <td>${rt.length ? (mean(rt) / 1000).toFixed(2) + ' ± ' + (sd(rt) / 1000).toFixed(2) : '—'}</td>
      </tr>`;
    }).join('');

    const pairs = [];
    for (let i = 0; i < conds.length; i++) {
      for (let j = i + 1; j < conds.length; j++) {
        const a = groups[conds[i]].abs, b = groups[conds[j]].abs;
        const r = tTestWelch(a, b);
        pairs.push({ a: conds[i], b: conds[j], t: r.t, p: r.p });
      }
    }
    const nPairs = pairs.length;
    pairs.forEach(p => p.pAdj = Math.min(1, p.p * nPairs));

    let pairRows = pairs.map(p => `<tr>
      <td>${p.a} vs ${p.b}</td>
      <td>${p.t.toFixed(2)}</td>
      <td>${fmtP(p.p)}</td>
      <td>${fmtP(p.pAdj)}</td>
      <td>${p.pAdj < 0.05 ? '✓' : ''}</td>
    </tr>`).join('');

    document.getElementById('p-statArea').innerHTML = `
      <h3 style="font-size:16px;color:#333;margin:0 0 8px;">⑤ 统计检验</h3>
      <div style="font-size:13px;color:#444;margin-bottom:10px;text-align:left;">
        <b>ANOVA（|误差|）</b>：F(${anovaAbs.dfB}, ${anovaAbs.dfW}) = ${anovaAbs.F.toFixed(2)},
        p = ${fmtP(anovaAbs.p)}${sig(anovaAbs.p)}, η² = ${anovaAbs.eta2.toFixed(3)}<br>
        <b>ANOVA（RT）</b>：F(${anovaRT.dfB}, ${anovaRT.dfW}) = ${anovaRT.F.toFixed(2)},
        p = ${fmtP(anovaRT.p)}${sig(anovaRT.p)}, η² = ${anovaRT.eta2.toFixed(3)}
      </div>
      <table class="p-stat-table">
        <tr>
          <th>条件</th><th>N</th><th>|误差| M±SD</th><th>|误差| 中位数</th>
          <th>误差 M±SD</th><th>RT M±SD (s)</th>
        </tr>
        ${descRows}
      </table>
      <table class="p-stat-table">
        <tr>
          <th>两两比较（|误差|）</th><th>t</th><th>p</th><th>p (Bonf.)</th><th>显著</th>
        </tr>
        ${pairRows}
      </table>
      <p style="font-size:11px;color:#999;margin-top:6px;text-align:left;">
        注：Welch t 检验 + Bonferroni 校正；η² 效应量 0.01 小 / 0.06 中 / 0.14 大。
      </p>
    `;
  }
})();

