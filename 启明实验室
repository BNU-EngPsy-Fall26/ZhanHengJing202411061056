<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>启明实验室 | Qiming Lab</title>
<style>
  /* ================= 实验室首页样式 ================= */
  body.lab-mode {
    margin: 0; padding: 0;
    background-color: #F4F4F0;
    font-family: "Microsoft YaHei", "PingFang SC", "Space Grotesk", sans-serif;
    overflow-x: hidden;
    color: #000;
    display: block;
  }

  .raw-bg-element { position: absolute; z-index: 0; opacity: 0.1; pointer-events: none; }
  .bg-1 { width: 800px; height: 800px; background: #FF00FF; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; top: -200px; left: -200px; }
  .bg-2 { width: 600px; height: 600px; background: #00FF00; top: 50%; right: -300px; transform: rotate(45deg); }
  .bg-3 { width: 100%; height: 2px; background: #000; top: 30%; left: 0; opacity: 1; transform: rotate(-5deg); z-index: 1;}

  .lab-container {
    position: relative; z-index: 10;
    width: 90vw; max-width: 1200px;
    margin: 80px auto 100px 5vw;
    display: flex; flex-direction: column; gap: 120px;
  }

  .title-wrapper { position: relative; transform: rotate(-3deg); }
  .title-main {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(80px, 12vw, 160px);
    font-style: italic; font-weight: 900; color: #000;
    margin: 0; line-height: 0.8; letter-spacing: -0.05em;
    text-shadow: 6px 6px 0 #00FF00;
  }
  .title-sub {
    position: absolute; bottom: -40px; right: 10%;
    font-family: "Courier New", monospace; font-size: 24px; font-weight: bold;
    background: #000; color: #00FF00; padding: 10px 20px;
    transform: rotate(5deg); letter-spacing: 2px;
  }

  .experiment-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }

  .exp-card {
    background: #fff; border: 5px solid #000; padding: 40px;
    position: relative; cursor: pointer; transition: all 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 15px 15px 0 #000;
  }
  .exp-card.card-1 { transform: rotate(2deg) translateY(20px); margin-left: 10%; }
  .exp-card.card-1:hover { transform: rotate(0deg) translateY(10px) scale(1.02); box-shadow: 8px 8px 0 #FF00FF, 15px 15px 0 #000; }
  .exp-card.card-2 { transform: rotate(-4deg) translateY(-60px) translateX(-40px); background: #F4F4F0; }
  .exp-card.card-2:hover { transform: rotate(-1deg) translateY(-70px) translateX(-30px) scale(1.02); box-shadow: -15px 15px 0 #00FF00, 15px 30px 0 #000; }

  .card-tag {
    position: absolute; top: -20px; left: 30px;
    background: #000; color: #fff; font-family: "Courier New", monospace;
    padding: 5px 15px; font-size: 16px; font-weight: bold;
  }
  .exp-card h2 { font-family: Georgia, serif; font-size: 42px; margin: 0 0 20px 0; border-bottom: 3px dashed #000; padding-bottom: 15px; }
  .exp-card p { font-size: 18px; line-height: 1.6; color: #333; margin-bottom: 30px; }
  .card-action {
    display: inline-block; background: #000; color: #fff; padding: 12px 30px;
    font-size: 20px; font-weight: bold; text-transform: uppercase; border: none; cursor: pointer;
  }
  .exp-card:hover .card-action { background: #FF00FF; color: #000; }

  /* ================= 知情同意弹窗 ================= */
  #consent-overlay {
    display: none; position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,0.85); align-items: center; justify-content: center;
    backdrop-filter: blur(5px);
  }
  .consent-box {
    width: 650px; max-width: 92vw; background: #fff; padding: 50px;
    border: 4px solid #000; box-shadow: 15px 15px 0 #00FF00;
    transform: rotate(1deg); position: relative;
  }
  .consent-box h2 { font-family: Georgia, serif; font-size: 32px; margin-bottom: 30px; border-bottom: 4px solid #000; padding-bottom: 10px; }
  .consent-item { margin-bottom: 20px; }
  .consent-item label { font-size: 16px; font-weight: bold; display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
  .consent-item input[type="checkbox"] { width: 20px; height: 20px; cursor: pointer; margin-top: 2px; accent-color: #000; }
  .consent-input-group { margin-bottom: 30px; }
  .consent-input-group label { font-size: 16px; font-weight: bold; margin-bottom: 10px; display: block; }
  .consent-input-group input[type="text"] {
    width: 100%; padding: 15px; font-size: 18px; border: 3px solid #000; background: #F4F4F0;
    font-family: "Courier New", monospace; outline: none; box-sizing: border-box;
  }
  .consent-input-group input[type="text"]:focus { background: #fff; box-shadow: 5px 5px 0 #FF00FF; }
  .consent-btn {
    width: 100%; padding: 20px; background: #000; color: #00FF00; font-size: 20px; font-weight: bold;
    border: none; cursor: pointer; transition: all 0.2s; font-family: inherit;
  }
  .consent-btn:disabled { background: #ccc; color: #666; cursor: not-allowed; box-shadow: none; }
  .consent-btn:not(:disabled):hover { background: #00FF00; color: #000; }

  /* ================= 实验外壳 ================= */
  .experiment-container {
    display: none !important;
    width: 100%; justify-content: center; align-items: flex-start;
    min-height: 100vh; background: #f0f2f5; position: fixed; inset: 0; z-index: 1000; overflow-y: auto;
    padding: 30px 12px;
  }
  .experiment-container.active { display: flex !important; }

  /* ================= 比例判断实验（片段样式，全部带 p- 前缀） ================= */
  #exp-proportion .p-app {
    width: 1000px; max-width: 96vw; min-height: 700px; background: #fff;
    border-radius: 12px; box-shadow: 0 4px 30px rgba(0,0,0,0.1);
    position: relative; display: flex; flex-direction: column; overflow: hidden;
  }
  #exp-proportion .p-page { display: none; width: 100%; min-height: 700px; flex-direction: column; align-items: center; justify-content: center; }
  #exp-proportion .p-page.p-active { display: flex; }
  #exp-proportion #p-topBar {
    position: absolute; top: 0; left: 0; width: 100%; height: 50px;
    display: none; justify-content: space-between; padding: 15px 30px; box-sizing: border-box;
    font-size: 14px; color: #666; font-weight: bold;
  }
  #exp-proportion #p-topBar.p-show { display: flex; }
  #exp-proportion #p-topBar .p-progress,
  #exp-proportion #p-topBar .p-question { background: #999; color: #fff; padding: 2px 10px; border-radius: 12px; }
  #exp-proportion #p-displayArea { flex: 1; width: 100%; display: flex; align-items: center; justify-content: center; margin-top: 40px; }
  #exp-proportion #p-fixation { font-size: 60px; font-weight: bold; color: #333; display: none; }
  #exp-proportion svg { overflow: visible; }
  #exp-proportion .shape-fill { fill: #e2e8f0; stroke: #1e3a8a; stroke-width: 2; }
  #exp-proportion .label-text { fill: #E74C3C; font-weight: bold; font-size: 22px; font-family: sans-serif; }
  #exp-proportion .tick-mark { stroke: #1e3a8a; stroke-width: 2; stroke-dasharray: 4,4; }
  #exp-proportion .tick-text { fill: #1e3a8a; font-size: 16px; font-family: sans-serif; font-weight: bold; }
  #exp-proportion #p-controlPanel {
    width: 90%; min-height: 90px; background: #0f172a; border-radius: 12px;
    margin: 0 auto 30px auto; display: none; align-items: center; justify-content: space-between;
    padding: 12px 30px; color: #fff; box-sizing: border-box; gap: 16px; flex-wrap: wrap;
  }
  #exp-proportion #p-controlPanel.p-show { display: flex; }
  #exp-proportion .p-answer-group { display: flex; align-items: center; gap: 15px; }
  #exp-proportion .p-answer-group > span { font-size: 18px; font-weight: bold; color: #eab308; }
  #exp-proportion .p-answer-input { display: flex; align-items: center; background: #fff; border-radius: 6px; padding: 2px; }
  #exp-proportion .p-answer-input input[type="number"] {
    width: 80px; height: 40px; font-size: 20px; text-align: center;
    border: none; outline: none; font-weight: bold; color: #333;
  }
  #exp-proportion .p-answer-input span { color: #333; font-size: 18px; padding-right: 10px; }
  #exp-proportion input[type="range"] {
    -webkit-appearance: none; width: 280px; max-width: 60vw; height: 8px; background: #cbd5e1;
    border-radius: 5px; outline: none; margin: 0 15px;
  }
  #exp-proportion input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 24px; height: 24px; background: #3b82f6;
    border-radius: 50%; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.3);
  }
  #exp-proportion button {
    background: #8c7a59; color: #fff; border: none; border-radius: 8px;
    padding: 12px 30px; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.2s;
  }
  #exp-proportion button:hover { background: #756449; }
  #exp-proportion button:disabled { background: #555; cursor: not-allowed; }
  #exp-proportion #p-feedbackOverlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: #ffffff; display: none; flex-direction: column;
    align-items: center; justify-content: center; z-index: 100; border-radius: 12px;
  }
  #exp-proportion #p-feedbackOverlay.p-show { display: flex; }
  #exp-proportion #p-feedbackOverlay h2 { font-size: 28px; color: #333; margin-bottom: 20px; }
  #exp-proportion #p-feedbackOverlay p { font-size: 20px; color: #666; margin-bottom: 10px; }
  #exp-proportion .fb-highlight { font-size: 24px; color: #E74C3C; font-weight: bold; }
  #exp-proportion #p-finished { overflow-y: auto; justify-content: flex-start; padding: 30px 0; }
  #exp-proportion #p-finished .p-analysis-wrap { width: 100%; padding: 0 40px; box-sizing: border-box; }
  #exp-proportion .p-analysis-wrap h2 { text-align: center; font-size: 24px; color: #333; margin-bottom: 6px; }
  #exp-proportion .p-analysis-sub { color: #888; font-size: 13px; text-align: center; margin-bottom: 18px; }
  #exp-proportion .p-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 26px; }
  #exp-proportion .p-chart-title { font-size: 15px; font-weight: bold; color: #333; margin-bottom: 6px; text-align: center; }
  #exp-proportion .p-chart-note { font-size: 11px; color: #999; margin-top: 4px; text-align: center; }
  #exp-proportion .p-stat-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 14px; }
  #exp-proportion .p-stat-table th,
  #exp-proportion .p-stat-table td { padding: 7px; border: 1px solid #ddd; text-align: center; }
  #exp-proportion .p-stat-table th { background: #f0f2f5; }

  /* ================= 视觉搜索实验（片段样式，全部带 v- 前缀） ================= */
  #exp-visual .v-app {
    width: 900px; max-width: 96vw; background: #fff; border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1); padding: 40px; position: relative;
    box-sizing: border-box;
  }
  #exp-visual .v-page { display: none; text-align: center; padding-top: 20px; }
  #exp-visual .v-page.v-active { display: block; }
  #exp-visual h1 { font-size: 28px; margin-bottom: 20px; color: #333; }
  #exp-visual h2 { font-size: 22px; margin-bottom: 20px; color: #333; }
  #exp-visual h3 { font-size: 18px; color: #333; margin: 20px 0 10px 0; border-left: 4px solid #4A90D9; padding-left: 10px; text-align: left; }
  #exp-visual p { font-size: 16px; color: #666; line-height: 1.8; margin-bottom: 10px; }
  #exp-visual .v-rule { font-size: 16px; color: #555; line-height: 2; margin-bottom: 15px; }
  #exp-visual .v-demo-box {
    display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;
    background: #fafafa; border: 1px solid #ddd; border-radius: 8px;
    padding: 20px; margin: 20px 0;
  }
  #exp-visual .v-demo-item { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  #exp-visual .v-shape { position: absolute; cursor: default; user-select: none; display: flex; justify-content: center; align-items: center; box-sizing: border-box; }
  #exp-visual .v-shape.v-circle { width: 36px; height: 36px; border-radius: 50%; border: 4px solid; }
  #exp-visual .v-shape.v-cross { width: 36px; height: 36px; font-size: 32px; font-weight: bold; line-height: 1; }
  #exp-visual .v-shape.v-circle.v-red, #exp-visual .v-shape.v-cross.v-red { border-color: #E74C3C; color: #E74C3C; }
  #exp-visual .v-shape.v-circle.v-blue, #exp-visual .v-shape.v-cross.v-blue { border-color: #3498DB; color: #3498DB; }
  #exp-visual .v-shape.v-circle.v-orange, #exp-visual .v-shape.v-cross.v-orange { border-color: #F39C12; color: #F39C12; }
  #exp-visual .v-demo-box .v-shape { position: relative; }
  #exp-visual button {
    margin-top: 20px; padding: 14px 50px; font-size: 18px;
    background: #4A90D9; color: #fff; border: none; border-radius: 8px;
    cursor: pointer; transition: background 0.2s;
  }
  #exp-visual button:hover { background: #357ABD; }
  #exp-visual button:disabled { background: #ccc; cursor: not-allowed; }
  #exp-visual .v-btn-green { background: #5CB85C; }
  #exp-visual .v-btn-green:hover { background: #4cae4c; }
  #exp-visual #v-experiment { display: none; }
  #exp-visual #v-experiment.v-active { display: block; }
  #exp-visual #v-progress { text-align: right; font-size: 14px; color: #999; margin-bottom: 10px; font-weight: bold; }
  #exp-visual #v-stimulusArea {
    width: 100%; height: 500px; position: relative;
    background: #fafafa; border-radius: 8px; border: 2px dashed #ddd;
    overflow: hidden;
  }
  #exp-visual #v-feedback {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    font-size: 40px; font-weight: bold; display: none; z-index: 10;
  }
  #exp-visual .fb-correct { color: #5CB85C; }
  #exp-visual .fb-wrong { color: #E74C3C; }
  #exp-visual .fb-timeout { color: #999; }
  #exp-visual #v-fixation {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    font-size: 40px; font-weight: bold; color: #000; display: none; z-index: 10;
  }
  #exp-visual #v-keyHint { text-align: center; margin-top: 15px; font-size: 16px; font-weight: bold; color: #555; }
  #exp-visual #v-finished { display: none; text-align: left; padding: 20px 0; }
  #exp-visual #v-finished.v-active { display: block; }
  #exp-visual #v-finished h2, #exp-visual #v-finished > p { text-align: center; }
  #exp-visual .v-chart-section { display: flex; flex-direction: column; align-items: center; margin-top: 20px; }
  #exp-visual canvas { border: 1px solid #eee; border-radius: 8px; background: #fff; margin-bottom: 10px; max-width: 100%; }
  #exp-visual .v-legend { display: flex; justify-content: center; gap: 20px; font-size: 14px; margin-bottom: 20px; flex-wrap: wrap; }
  #exp-visual .v-legend-item { display: flex; align-items: center; gap: 5px; }
  #exp-visual .v-legend-color { width: 16px; height: 16px; border-radius: 4px; }
  #exp-visual .v-data-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
  #exp-visual .v-data-table th, #exp-visual .v-data-table td { border: 1px solid #ddd; padding: 8px; text-align: center; }
  #exp-visual .v-data-table th { background: #f5f5f5; font-weight: bold; }
  #exp-visual .v-explanation-box {
    background: #f0f7ff; padding: 15px; border-radius: 8px;
    border-left: 4px solid #4A90D9; color: #333; line-height: 1.6; margin-top: 20px; text-align: left;
  }

  @media (max-width: 720px) {
    #exp-proportion .p-grid2 { grid-template-columns: 1fr; }
    #exp-visual .v-app { padding: 20px 14px; }
    #exp-visual #v-stimulusArea { height: 380px; }
    .consent-box { padding: 26px 20px; }
  }
</style>
</head>
<body class="lab-mode">

  <!-- ================= 1. 实验室大厅 ================= -->
  <div id="lab-hub">
    <div class="raw-bg-element bg-1"></div>
    <div class="raw-bg-element bg-2"></div>
    <div class="raw-bg-element bg-3"></div>

    <div class="lab-container">
      <div class="title-wrapper">
        <h1 class="title-main">Qiming<br>Lab.</h1>
        <div class="title-sub">启明实验室 // 认知实验平台</div>
      </div>

      <div class="experiment-grid">
        <div class="exp-card card-1" onclick="tryEnterLab('proportion')">
          <div class="card-tag">EXP_01 / PROPORTION</div>
          <h2>比例判断实验</h2>
          <p>考察您对空间比例（长度、角度、面积）的主观感知。包含条形、扇形等多种动态图形阵列，并附带详细的数据统计报告。</p>
          <button class="card-action">进入实验 →</button>
        </div>

        <div class="exp-card card-2" onclick="tryEnterLab('visual')">
          <div class="card-tag" style="background:#FF00FF; color:#000;">EXP_02 / VISUAL_SEARCH</div>
          <h2>视觉搜索实验</h2>
          <p>基于特征整合理论，探究在复杂背景下（颜色与形状）寻找目标物的视觉效率与搜索斜率。</p>
          <button class="card-action">进入实验 →</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= 2. 全局知情同意弹窗 ================= -->
  <div id="consent-overlay">
    <div class="consent-box">
      <h2>参与实验知情同意</h2>

      <div class="consent-item">
        <label>
          <input type="checkbox" id="agree-1" onchange="checkConsent()">
          <span>我同意本次实验产生的数据上传到研究平台，用于学术分析。</span>
        </label>
      </div>

      <div class="consent-item">
        <label>
          <input type="checkbox" id="agree-2" onchange="checkConsent()">
          <span>我了解我的个人信息将被严格保密（仅收集匿名编号，不涉及真实姓名）。</span>
        </label>
      </div>

      <div class="consent-input-group" style="margin-top: 30px;">
        <label>请输入您的匿名编号（仅限字母和数字）</label>
        <input type="text" id="global-participantId" maxlength="20" placeholder="例如：P001" oninput="checkConsent()">
      </div>

      <button class="consent-btn" id="confirm-btn" onclick="confirmConsent()" disabled>同意并开始实验</button>
    </div>
  </div>

  <!-- ================= 3. 比例判断实验（片段） ================= -->
  <div id="exp-proportion" class="experiment-container">
    <div class="p-app">

      <!-- 说明页（入口页，已删除编号输入） -->
      <div id="p-instruction" class="p-page p-active">
        <h2 id="p-instTitle" style="font-size:24px; color:#333; margin-bottom:20px;">任务说明</h2>
        <div id="p-instGraphic" style="margin-bottom:30px; display:flex; justify-content:center; gap:50px;"></div>
        <p id="p-instText" style="font-size:18px; color:#666; margin-bottom:40px; text-align:center; max-width:700px; line-height:1.8;"></p>
        <button id="p-instBtn" onclick="pStartPractice()" style="background:#4A90D9;">开始练习</button>
      </div>

      <!-- 实验页 -->
      <div id="p-experiment" class="p-page" style="justify-content:flex-start;">
        <div id="p-topBar">
          <div class="p-progress" id="p-progressText">1 / 40</div>
          <div class="p-question">B 是 A 的百分之几？</div>
        </div>

        <div id="p-displayArea">
          <div id="p-fixation">+</div>
        </div>

        <div id="p-controlPanel">
          <div class="p-answer-group">
            <span>B 是 A 的</span>
            <div class="p-answer-input">
              <input type="number" id="p-answerInput" min="0" max="1000" value="50">
              <span>%</span>
            </div>
          </div>

          <div style="flex:1; display:flex; align-items:center; justify-content:flex-end; min-width:240px;">
            <input type="range" id="p-answerSlider" min="0" max="1000" value="500">
            <button onclick="pSubmitAnswer()" id="p-submitBtn">确定 (Enter)</button>
          </div>
        </div>
      </div>

      <!-- 练习反馈 -->
      <div id="p-feedbackOverlay">
        <h2>作答反馈</h2>
        <p>实际比例是：<span class="fb-highlight" id="p-fbActual"></span></p>
        <p>你的比例是：<span class="fb-highlight" id="p-fbUser"></span></p>
        <button onclick="pNextTrial()">继续</button>
      </div>

      <!-- 结束页 -->
      <div id="p-finished" class="p-page">
        <div class="p-analysis-wrap" id="p-analysisWrap"></div>
      </div>

    </div>
  </div>

  <!-- ================= 4. 视觉搜索实验（片段） ================= -->
  <div id="exp-visual" class="experiment-container">
    <div class="v-app">

      <!-- 说明页（入口页，已删除编号输入） -->
      <div id="v-instructionBlock" class="v-page v-active">
        <h2 id="v-instTitle">条件一 任务说明</h2>
        <div class="v-demo-box">
          <div class="v-demo-item">
            <div class="v-shape v-circle v-red"></div>
            <span style="font-size:14px; font-weight:bold; color:#E74C3C;">目标物 (红圆)</span>
          </div>
          <div class="v-demo-item" id="v-distractorDemo1"></div>
        </div>
        <p class="v-rule" id="v-instText">文字描述</p>
        <p class="v-rule" style="font-weight:bold;">按 F 键 = 有目标 &nbsp;&nbsp;|&nbsp;&nbsp; 按 J 键 = 无目标</p>
        <p class="v-rule" style="font-size:14px; color:#888;" id="v-instPracticeText">点击下方按钮，进行 3 个试次的练习（有反馈）。</p>
        <button class="v-btn-green" id="v-instBtn" onclick="vStartPractice()">开始练习</button>
      </div>

      <!-- 实验页 -->
      <div id="v-experiment" class="v-page">
