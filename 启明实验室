  function createTrial(condition, phase, index) {
    const percentage = 20 + Math.random() * 70;
    const maxA = 300 / (1 + percentage / 100);
    const minA = 120;
    const a = minA + Math.random() * Math.max(0, maxA - minA);
    const b = a * (percentage / 100);
    const remaining = 360 - a - b;
    const x = remaining * (0.3 + Math.random() * 0.4);
    const y = remaining - x;

    return {
      trialId: `${Date.now()}-${index}-${Math.random()}`,
